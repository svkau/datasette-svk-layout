  "lonehandlingar": {
    "title_template": "Lönehandlingar - {unit_name}",
    "description_template": "Arkiverade uttag från lönesystem",
    "templates": {
      "database": "database-lonehandlingar-type.html",
      "queries": {
        "Personer": "query-lonehandlingar-type-Personer.html",
        "Lonekorningar": "query-lonehandlingar-type-Lonekorningar.html",
