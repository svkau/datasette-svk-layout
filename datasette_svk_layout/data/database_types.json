    "queries": {
      "SokArenden": {
        "allow": {
          "permissions": ["access.search_casefiles", "access.search_casefiles_confidentiality", "access.search_everything"]
        },
        "sql": "SELECT a.objectId, a.title, a.classificationCode, a.classificationText, a.status, a.opened, a.closed, a.responsible, a.counterpart, a.diary, a.confidential, (SELECT COUNT(*) FROM aggregationrestriction ar WHERE ar.aggregation_id = a.objectId) AS has_restriction FROM aggregation a JOIN aggregation_fts ON aggregation_fts.objectId = a.objectId WHERE aggregation_fts MATCH '\"' || replace(trim(:text), ' ', '\" \"') || '\"*' ORDER BY a.opened DESC LIMIT 200",
        "title": "Sök ärenden",
        "hide_sql": true
      },
      "SokHandlingar": {
        "allow": {
          "permissions": ["access.search_casefiles", "access.search_casefiles_confidentiality", "access.search_everything"]
        },
        "sql": "SELECT r.objectId, r.title, r.direction, r.recordType, r.sender, r.receiver, r.confidential, r.Aggregation_id, a.title AS aggregation_title, a.classificationCode, a.confidential AS agg_confidential, (SELECT COUNT(*) FROM recordrestriction rr WHERE rr.record_id = r.objectId) AS has_restriction, (SELECT COUNT(*) FROM aggregationrestriction ar WHERE ar.aggregation_id = r.Aggregation_id) AS agg_has_restriction FROM record r LEFT JOIN aggregation a ON r.Aggregation_id = a.objectId JOIN record_fts ON record_fts.objectId = r.objectId WHERE record_fts MATCH '\"' || replace(trim(:text), ' ', '\" \"') || '\"*' ORDER BY r.objectId DESC LIMIT 200",
        "title": "Sök handlingar",
        "hide_sql": true
      }
    }
