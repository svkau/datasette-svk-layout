    "queries": {
      "Personer": {
        "allow": {
          "permissions": ["access.search_salaries", "access.search_everything"]
        },
        "sql": "SELECT fornamn || ' ' || efternamn AS Namn, personnummer AS Personnummer, anstallningsnummer AS Anstallningsnummer, befattning AS Befattning, anstallning_id AS AnstallningID FROM anstallningar WHERE fornamn || ' ' || efternamn LIKE '%' || :text || '%' OR personnummer LIKE '%' || :text || '%' OR CAST(anstallningsnummer AS TEXT) LIKE '%' || :text || '%' ORDER BY efternamn, fornamn",
        "title": "Sök anställd",
        "hide_sql": true
      },
      "Lonekorningar": {
        "allow": {
          "permissions": ["access.search_salaries", "access.search_everything"]
        },
        "sql": "SELECT lt.loneart_kod AS Loneart_kod, lt.loneart_namn AS Loneart, lt.belopp_sek AS Belopp, lt.antal AS Antal, lt.enhet AS Enhet, lt.apris AS Apris, lt.transaktionsrad_text AS Text, lk.fornamn || ' ' || lk.efternamn AS Namn, lk.anstallningsnummer AS Anstallningsnummer, lk.anstallning_id AS AnstallningID, ltk.dim01_varde AS Konto, ltk.dim02_varde AS Kostnadsstalle FROM lonetransaktioner lt JOIN lonekorningar lk ON lt.lonekorning_id = lk.lonekorning_id LEFT JOIN lonetransaktion_konteringar ltk ON lt.lonetransaktion_id = ltk.lonetransaktion_id WHERE lk.lonekorningsnummer = :period ORDER BY lk.efternamn, lk.fornamn, lt.loneart_kod",
        "title": "Lönetransaktioner per period",
        "hide_sql": true
      },
      "AnstallningLonekorningar": {
        "allow": {
          "permissions": ["access.search_salaries", "access.search_everything"]
        },
        "sql": "SELECT 1",
        "title": "Lönekörningar",
        "hide_sql": true
      }
    },
